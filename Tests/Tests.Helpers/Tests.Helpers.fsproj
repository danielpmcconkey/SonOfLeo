<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Tests.Helpers</RootNamespace>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Cleanup.fs" />
    <Compile Include="Railroad.fs" />
    <Compile Include="GenericTestProperties.fs" />
    <Compile Include="EntityFunctions.fs" />
    <Compile Include="TestDataStage.fs" />
    <Compile Include="RouteResolver.fs" />
    <Compile Include="SadPath.fs" />
    <Compile Include="CliExecutor.fs" />
    <Compile Include="TestError.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\App.Session\App.Session.fsproj" />
    <ProjectReference Include="..\..\Src\App.DataAccessLayer\App.DataAccessLayer.fsproj" />
    <ProjectReference Include="..\..\Src\Ui.InterfaceBridge\Ui.InterfaceBridge.fsproj" />
    <ProjectReference Include="..\..\Src\Business.CrossDomainOrchestration\Business.CrossDomainOrchestration.fsproj" />
    <ProjectReference Include="..\..\Src\Model\Model.fsproj" />
    <ProjectReference Include="..\..\Src\App.Utility\App.Utility.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
