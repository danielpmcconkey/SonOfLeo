<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LookupCache.fs" />
    <Compile Include="Audit.fs" />
    <Compile Include="Money.fs" />
    <Compile Include="Ledger\JournalEntryPrimitives.fs" />
    <Compile Include="Ledger\AccountComponent.fs" />
    <Compile Include="Ledger\Account.fs" />
    <Compile Include="Ledger\FiscalPeriodComponent.fs" />
    <Compile Include="Ledger\FiscalPeriod.fs" />
    <Compile Include="Ledger\JournalEntryComponent.fs" />
    <Compile Include="Ledger\JournalEntryHeader.fs" />
    <Compile Include="Ledger\JournalEntryLine.fs" />
    <Compile Include="Ledger\JournalEntryExternalReference.fs" />
    <Compile Include="Ledger\JournalEntryComment.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Utilities\Utilities.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageReference Include="NodaTime" Version="3.3.3" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
  </ItemGroup>

</Project>
