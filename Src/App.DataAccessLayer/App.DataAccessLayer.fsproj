<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>App.DataAccessLayer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DalError.fs" />
    <Compile Include="DbConnection.fs" />
    <Compile Include="DbTransaction.fs" />
    <Compile Include="QueryParameter.fs" />
    <Compile Include="ExecuteReader.fs" />
    <Compile Include="ExecuteNonQuery.fs" />
    <Compile Include="ExecuteScalar.fs" />
    <Compile Include="LookupCache.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.NodaTime" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Utility\App.Utility.fsproj" />
  </ItemGroup>

</Project>
