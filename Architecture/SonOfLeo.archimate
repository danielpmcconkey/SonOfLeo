<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="SonOfLeo" id="id-de6f8ddd8a27468c990b7acce7c4213f" version="5.0.0">
  <folder name="Strategy" id="id-0fec2bd0728c44bd8e8cd9e334bbf654" type="strategy"/>
  <folder name="Business" id="id-7d3aa2f955c34e1f8e8549a372ab1cf5" type="business"/>
  <folder name="Application" id="id-3bc109dcc8a54eae80d3db78cbe5ab6d" type="application">
    <folder name="Capabilities (the &quot;what&quot;)" id="id-7b2b3d6cb06947c28e06842139decdca">
      <folder name="User interface functions" id="id-3d461a5846364b8da9d3629cae1b1cf4">
        <folder name="Marshalling functions" id="id-cc92e0f496af40afa21403604f2143a8">
          <element xsi:type="archimate:ApplicationFunction" name="Marshalling functions" id="id-f1b897e32ea640df958e6d4ae7cb94ab">
            <documentation>Behaviours that convert values between the representations used by different system layers or external interfaces. Members of this clade share a defining characteristic: they transform a value's shape or identity system without changing its semantic meaning — the information is preserved, only the representation changes.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert JSON to type" id="id-df4182cf3827423cb4997ac9943c8ece">
            <documentation>Given a JSON text, produce a typed application value. Fails with a structured error if the text is malformed or does not conform to the expected structure.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert model types to UI types" id="id-7ab29727dd884711ae7ae55418d07364">
            <documentation>Given an internal model value, produce the corresponding external-facing representation suitable for display or transmission to a caller.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert type to JSON" id="id-ebd67762a6f341d68066daf006c59d2c">
            <documentation>Given a typed application value, produce its JSON text representation.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Map between field updates of different types" id="id-2d3e601290e443969fed00bf4bf61a12">
            <documentation>Given an update instruction for a field of one type, produce the equivalent update instruction for a field of another type. Preserves the intent (no-change vs set-to-value) while transforming the value's representation.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert account code to account ID" id="id-70ed622087b248fab04f464db64c9eb8">
            <documentation>Given a human-readable account code, resolve the corresponding typed account identifier.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert account ID to account Code" id="id-13db9558afd2425eb3b0ecec2fdaf3dc">
            <documentation>Given a typed account identifier, resolve the corresponding human-readable account code.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert account ID to account name" id="id-455dc9d54b644a6eb68d20d5f4ca394d">
            <documentation>Given a typed account identifier, resolve the corresponding human-readable account name.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert fiscal period key to fiscal period ID" id="id-c1f1923bd18f4d46a34b997955f0187f">
            <documentation>Given a human-readable fiscal period key, resolve the corresponding typed fiscal period identifier.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert fiscal period ID to fiscal period key" id="id-a5fe08ac5076443aaa01cb01d2bf903d">
            <documentation>Given a typed fiscal period identifier, resolve the corresponding human-readable fiscal period key.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert master agreement name to master agreement ID" id="id-8e449d623cda4e4b9defc862e441bb80">
            <documentation>Given a human-readable master agreement name, resolve the corresponding typed master agreement identifier.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert master agreement ID to master agreement name" id="id-fbf3c4c93517469cadac3780d66ed506">
            <documentation>Given a typed master agreement identifier, resolve the corresponding human-readable master agreement name.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert payment agreement name to payment agreement ID" id="id-d4a4397da7314482b1f718602d167ff7">
            <documentation>Given a human-readable payment agreement name, resolve the corresponding typed payment agreement identifier.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert payment agreement ID to payment agreement name" id="id-819181a73eb242cd8eecc4e521c0ac53">
            <documentation>Given a typed payment agreement identifier, resolve the corresponding human-readable payment agreement name.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert between Money and decimal" id="id-d17175e2af754f55b96311c5b7e2798d">
            <documentation>Convert between a constrained monetary value and its raw numeric representation. The monetary representation enforces precision and bounds; the numeric representation does not.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert money to formatted string" id="id-91d05bc1c10645eb9c304786e78ff361">
            <documentation>Given a monetary value, produce a human-readable formatted string (e.g. with currency symbol and decimal places).</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert date to formatted string" id="id-304f719606244845a5828e494cdc0fa0">
            <documentation>Given a calendar date, produce a human-readable formatted string.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert instant to formatted string" id="id-03be56fa55dc4a2896d4f7945fe8a83b">
            <documentation>Given a point in absolute time, produce a human-readable formatted string in the system's configured local time zone.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert UI inputs to model types" id="id-f6b342fbee2a48a0b244c29d6f922517">
            <documentation>Given an external-facing input contract, produce the corresponding typed model value, failing with a structured error when a value does not resolve or validate.</documentation>
          </element>
        </folder>
        <folder name="Report rendering functions" id="id-165bafb472f444a2805e2f255b326d6b">
          <element xsi:type="archimate:ApplicationFunction" name="Report rendering functions" id="id-81f15056b78a44a5afab257a640f65a1">
            <documentation>Behaviours that turn report data into a rendered document.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Model HTML document structure" id="id-1812ffaec36446c1a816dd1dcf98b772">
            <documentation>Typed building blocks for a report's head, body, elements and styles.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Render HTML to text" id="id-d3cf6ac238834e4da2702f3a4d5918d4">
            <documentation>Serialise typed HTML building blocks into markup.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Provide base report styling" id="id-cd50a0546ad4432ca6ef41e2b8ac3dfc">
            <documentation>The style declarations every report shares.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Render report header" id="id-60e4aaec57b1412fad5403f0fcc78edf">
            <documentation>Produce a report's title and as-of subtitle.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Render report body" id="id-c96eb12007b949e09053d45f98b45a7b">
            <documentation>Wrap a report's sections in its body.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Render report footer" id="id-3d7b145c41ee4731acd0a7d3da2d91f6">
            <documentation>Produce a report's footer with its generation time.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Write trial balance report" id="id-2c51526f7e044071a9d075bb13b21a11">
            <documentation>Render trial balance rows as a styled document and write it to a file.</documentation>
          </element>
        </folder>
        <folder name="Command-line interface functions" id="id-14459caef3f240fb9ad3bdadde5f4164">
          <element xsi:type="archimate:ApplicationFunction" name="Command-line interface functions" id="id-63104379c1de472a8a7284b03f235591">
            <documentation>Behaviours that accept operator input at a command line and hand it to a route.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Dispatch an operator command to its route" id="id-36ff365881994641a216bc06eed13d8f">
            <documentation>Parse a domain, verb and JSON input from the command line and run the matching command route.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Dispatch a report request to its route" id="id-b813c24c6ed84f1db4a1c0afc8508927">
            <documentation>Parse a report name and JSON input from the command line and run the matching report route.</documentation>
          </element>
        </folder>
        <element xsi:type="archimate:ApplicationFunction" name="Define interface contracts" id="id-bdf8e1de36cc41cf9328712cefa66068">
          <documentation>Declare the shape of each operation the system exposes to callers — the expected inputs, the possible outputs, and the error conditions. Contracts are the authoritative specification of what the interface promises. They exist independently of any specific caller.</documentation>
        </element>
        <element xsi:type="archimate:ApplicationFunction" name="Define UI routes" id="id-fbe2da93dcb0477ba25e2c7f896d6249">
          <documentation>Map each user-facing command to the interface contract that fulfils it. Routes are the dispatch table — they decide which contract handles which request. They do not contain business logic.</documentation>
        </element>
        <element xsi:type="archimate:ApplicationFunction" name="User interface functions" id="id-e18bfee1b44147a3a8798af0b6488db5"/>
      </folder>
      <folder name="Orchestration and choreography functions" id="id-c22ca410e83240aea395e049cd1b7fc3">
        <element xsi:type="archimate:ApplicationFunction" name="Orchestration and choreography functions" id="id-42c55b135db04cdd891328c22493c26d">
          <documentation>Behaviours that coordinate multiple lower-level operations into a coherent use case. Members of this clade share a defining characteristic: they sequence, scope, and govern the execution of other functions — they do not perform domain work themselves, they ensure domain work happens in the right order with the right context.</documentation>
        </element>
        <element xsi:type="archimate:ApplicationFunction" name="End-to-end use case orchestration" id="id-5d26474bdf7d4dc5be3762bee38db8b1">
          <documentation>Coordinate all steps of a complete user-facing operation from entry to final outcome. The orchestrator decides what happens in what order, delegates each step, and determines the overall success or failure.</documentation>
        </element>
        <element xsi:type="archimate:ApplicationFunction" name="Wrap work-flow in an auto-complete runner" id="id-201082f0a3a347a0bd7aa0e7cb1a9619">
          <documentation>Execute a multi-step workflow within a governed scope that automatically determines final disposition. On success, the scope commits. On failure, the scope rolls back. The caller provides the work; the runner provides the governance.</documentation>
        </element>
        <element xsi:type="archimate:ApplicationFunction" name="Carry database transaction through a full use case" id="id-b014385ee7444b689d2f4fb16ca49c4c">
          <documentation>Ensure that all database operations within a use case participate in a single unit of work. The transaction is opened before the first operation and resolved (committed or rolled back) after the last.</documentation>
        </element>
        <element xsi:type="archimate:ApplicationFunction" name="Carry audit envelope through a full use case" id="id-eba512ac9974487dafe9cb9d946025b5">
          <documentation>Ensure that every auditable operation within a use case is stamped with the same audit identity and intent. The envelope is created at the start of the use case and travels with every operation that participates.</documentation>
        </element>
        <element xsi:type="archimate:ApplicationFunction" name="Run a route with automatic rollback" id="id-9cf80ddc1a8840068ce114ee6cd3e177">
          <documentation>Run a use case in a fresh context and roll back every database change afterwards, for shadow runs and tests.</documentation>
        </element>
      </folder>
      <folder name="Utility functions" id="id-90b3f0b96fa84f909a3d9317e7a8dc54">
        <folder name="Temporal functions" id="id-d722927fb5f94a0aa75549ea9bb78f8c">
          <element xsi:type="archimate:ApplicationFunction" name="Temporal functions" id="id-d864fc83f7164fff98c47c19a0cbdb7d">
            <documentation>Behaviours that reason about time — when things happen, what time it is, how dates relate to each other, and what recurrence patterns mean. Members of this clade share a defining characteristic: they interpret or produce temporal values (instants, dates, periods, cadences) in a time-zone-aware, precision-controlled manner.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert instant to date in localized time zone" id="id-7bc3c85ebcb641e6ad501cf4e36c7d50">
            <documentation>Given a point in absolute time, produce the calendar date that point falls on in the system's configured local time zone.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert instant to localized time" id="id-9b7ded58b8ad4dd7ac9944db8c69e79b">
            <documentation>Given a point in absolute time, produce a human-readable date-and-time representation in the system's configured local time zone.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch current date" id="id-42db1698b7c34f8992c0c923f00f3ea7">
            <documentation>Produce today's calendar date in the system's configured local time zone.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch current instant" id="id-b80b9b02693d4e119da0f2045214154e">
            <documentation>Produce the current point in absolute time, at a precision that survives a round trip through persistent storage without drift.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define valid temporal sequences" id="id-d3f157eefbc3499bb7cf09f0c485ff95">
            <documentation>Enumerate the recurrence patterns the system recognises (daily, weekly, every other week, monthly, annually) and define what each pattern means in terms of date advancement and date-fit validation.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Determine next expected instance" id="id-0bf183840e7a4e599ec325b88e132b07">
            <documentation>Given a prior date and a recurrence pattern, produce the next date in the sequence.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Validate dates against cadence" id="id-67e3e795b9c4465ea8f9b684e9c8e87e">
            <documentation>Given a candidate date and a recurrence pattern, determine whether the date is a valid member of that pattern's sequence. Rejects dates that fall on the wrong day, wrong week, or wrong month for the pattern.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Resolve a temporal filter to a date range" id="id-353bc9ce4cd2446a821fea6f9cdc564d">
            <documentation>Turn a fiscal period or explicit dates into one inclusive date range.</documentation>
          </element>
        </folder>
        <folder name="Observability functions" id="id-1f97d463d5a34701a2c41514b260da0c">
          <element xsi:type="archimate:ApplicationFunction" name="Observability functions" id="id-40bc347559894f50821d461f2d99157b">
            <documentation>Behaviours that make the system's actions visible and traceable after the fact. Members of this clade share a defining characteristic: they attach identity, timestamp, and intent metadata to operations so that what happened can be reconstructed later without relying on inference.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Create audit envelope" id="id-a0ab25ee64ea4d80bc14ec83a599df43">
            <documentation>Produce a stamped audit record — a unique identity, the declared intent of the operation, and the moment it began — that travels with the operation through its full lifecycle.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define auditable actions" id="id-5dbf082357b34cff99b082daf5fd4975">
            <documentation>Enumerate every operation the system considers worth tracking. Each action is a named intent — not a log level, not a category, but a specific statement of what the system set out to do.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define classification auditable actions" id="id-ef758b2bcc6a45f796daad4f41f71d66">
            <documentation>Enumerate every operation the system considers worth tracking. Each action is a named intent — not a log level, not a category, but a specific statement of what the system set out to do.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define cash flow auditable actions" id="id-2da59a9e1a2345db8f5c2b2a57d17fed">
            <documentation>Enumerate every operation the system considers worth tracking. Each action is a named intent — not a log level, not a category, but a specific statement of what the system set out to do.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define data ingestion auditable actions" id="id-3b359ffe35b64df69989e15027f8fca8">
            <documentation>Enumerate every operation the system considers worth tracking. Each action is a named intent — not a log level, not a category, but a specific statement of what the system set out to do.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Record actor" id="id-7017459d3c584ee1a051f17e98e3ffa4">
            <documentation>Identify which actor or process caused a state change, so that every mutation carries a record of who produced it. The set of actors is enumerated — not a free-text field, not a user ID, but a named category of authority.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define core auditable actions" id="id-2083c65c6e3948fda4096d32c1c63001">
            <documentation>Enumerate every operation the system considers worth tracking. Each action is a named intent — not a log level, not a category, but a specific statement of what the system set out to do.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define ledger auditable actions" id="id-561ac8e62ce941938193911ff882c48f">
            <documentation>Enumerate every operation the system considers worth tracking. Each action is a named intent — not a log level, not a category, but a specific statement of what the system set out to do.</documentation>
          </element>
        </folder>
        <folder name="Error management functions" id="id-d42e9fa229284c94a70089ddf7bb8c59">
          <element xsi:type="archimate:ApplicationFunction" name="Error management functions" id="id-8d46e44f9f5d4751b8cd0c5613fa0653">
            <documentation>Behaviours that define, propagate, and render application failure states. Members of this clade share a defining characteristic: they operate on the boundary between a failed computation and the system's response to that failure. They do not prevent errors or recover from them — they make errors nameable, composable, and reportable.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Convert list of results to results list" id="id-2f5e36c42fa64b83931ce1a6bab3f102">
            <documentation>Given a collection where each item may have independently succeeded or failed, produce a single success (all items) or a single failure (the first error). Collapses per-item uncertainty into a whole-collection verdict.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define application errors" id="id-561c1208ca8b4d1986744e1342fad2b7">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define report CLI errors" id="id-f85517c1bacf4625b6a5e527d50e7c52">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define operator CLI errors" id="id-4f1e30939ad2434c9843d4c4f37c9488">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define interface bridge errors" id="id-a00fff433b954d2daf250fc674180112">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define cash flow errors" id="id-a19ee4383f8f4be58f54eac19b29a0d4">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define data ingestion errors" id="id-f89fb1dc26b844d1a3771b75a0dc24c5">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Handle fallible option conversions" id="id-fc485aa391cf4dceb8df9cffd5d85936">
            <documentation>Apply a fallible conversion to a value that may be absent. If the value is absent, the result is absent — the conversion is never attempted. If the value is present, the conversion runs and its failure propagates.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Render error message" id="id-f9fcbf5300da46368607ffa214b20d95">
            <documentation>Given a named failure case, produce a human-readable description of what went wrong. This is the only path from a structured error to a display string. The rendering is deterministic — same error, same message.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Result binding abstraction" id="id-6426f61aae674b0288d9e3b5e322e0e2">
            <documentation>Provide a composable pipeline for sequencing fallible operations. Each step receives the prior step's success value and may produce its own success or failure. On first failure, the pipeline short-circuits — subsequent steps are never executed.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define utility errors" id="id-b7e6ec2bbd9b4b65ad59097d920c7d7b">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define data access errors" id="id-51f948dd8c694d6fbe07799b6871ff15">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define general business errors" id="id-6e28d36383794bdea18a3b5073e992da">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define core financial services errors" id="id-d058bbd365844dbb98af245f81b20e1b">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define ledger errors" id="id-649017c2f68c4697b2c76032bc792d69">
            <documentation>Provide an exhaustive vocabulary of named failure modes. Every failure the system can produce has exactly one name in this vocabulary. The vocabulary is domain-partitioned and extensible only by adding new named entries — never by catch-all or generic categories.</documentation>
          </element>
        </folder>
        <folder name="File functions" id="id-f225d70d71f44759b3bcbfe21c78af39">
          <element xsi:type="archimate:ApplicationFunction" name="File functions" id="id-d9889b7e85e1400188600fa55414ca8d">
            <documentation>Behaviours that interact with the local filesystem — verifying paths, reading content, writing content, and moving files. Members of this clade share a defining characteristic: they cross the boundary between in-process data and on-disk persistence, and they wrap OS-level failures into structured application errors.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Assemble paths" id="id-319141f048794a3cadf6961086e13c80">
            <documentation>Given path segments, produce a single well-formed filesystem path. Handles OS-specific separators and segment joining.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Confirm directory exists" id="id-081f1b2f5c854aa1a75ab34defde9a70">
            <documentation>Given a directory path, verify that it exists on the filesystem. Returns a structured error on absence — does not create the directory.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Confirm file exists" id="id-d360970404b348e3a0fd8231a7551611">
            <documentation>Given a file path, verify that it exists on the filesystem. Returns a structured error on absence — does not create the file.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Move file location" id="id-f6d2bb93dc274e94a4a5bbb5b4ee413f">
            <documentation>Given a source path and a destination path, relocate a file from one filesystem location to another. The source ceases to exist at the original path.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Read file contents" id="id-38d32527c70c48a184f137abe80a1dae">
            <documentation>Given a file path, return the file's content as a sequence of text lines. Fails with a structured error if the file does not exist or cannot be read.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Write file" id="id-3a8f7c2076664c1abda68cfde4eddf93">
            <documentation>Given a file path and text content, persist the content to the filesystem at that path. Creates or overwrites the file.</documentation>
          </element>
        </folder>
        <folder name="Config functions" id="id-a710f73454d843d1b14f4c16274f816e">
          <element xsi:type="archimate:ApplicationFunction" name="Config functions" id="id-ce0004d976024238b4ef2193df8455ec">
            <documentation>Behaviours that resolve externally-defined configuration values as typed application values. Members of this clade share a defining characteristic: they bridge between an external configuration source and the typed values the application operates on.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Cache application config values" id="id-273b1ef3581e46c5b664cb80ea773008">
            <documentation>Store a resolved configuration value by key so that subsequent requests for the same key return the cached value without re-reading the external source. The cache grows monotonically — values are never invalidated or replaced.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch application config values" id="id-7313a1cb7b2f4693ac1370bba842c078">
            <documentation>Given a configuration key, return the corresponding typed value. Checks cache first, reads from the external configuration source on miss. Fails with a structured error if the key does not exist or the value cannot be parsed to the requested type.</documentation>
          </element>
        </folder>
        <folder name="Core computing functions" id="id-673c67f797424025854bb8bc9e0db087">
          <element xsi:type="archimate:ApplicationFunction" name="Core computing functions" id="id-232e82540349438ab7e38877f5eb1254">
            <documentation>Behaviours that operate on primitive runtime values below the level of any domain concept. Members of this clade share a defining characteristic: they convert between untyped or weakly-typed representations and strongly-typed primitive values.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Primitive unboxing" id="id-afac11f3ee9a4e8c963b36402f8f975e">
            <documentation>Given an untyped runtime value, produce a typed primitive value. Handles both present values and absent (null) values. Fails with a structured error if the value cannot be interpreted as the requested type.</documentation>
          </element>
        </folder>
        <folder name="Data access functions" id="id-6f9844722aa043508547c827230c6f14">
          <element xsi:type="archimate:ApplicationFunction" name="Data access functions" id="id-8b834a97290b40c4b169e60df505d0b0">
            <documentation>Behaviours that mediate between the application and a relational database. Members of this clade share a defining characteristic: they cross the boundary between in-process typed data and persistent relational storage, abstracting the database engine's protocol, connection lifecycle, parameterisation, and result materialisation behind structured application types.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Abstract RDBMS-specific architecture" id="id-87e17fdabed043c9898f70cdc86ac167">
            <documentation>Isolate engine-specific concerns (provider types, connection pooling strategy, parameter binding conventions) behind an engine-neutral interface. Callers operate against the abstraction; only realisers know which database engine is in use.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Commit DB transactions" id="id-76facdb018594d49b1ebeb9daa4a2f6a">
            <documentation>Make all changes performed within an open transaction permanent. The transaction is consumed — it cannot be reused after commit.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Create DB connection" id="id-1f544412e4034e77b1430f13045e9e76">
            <documentation>Prepare the database subsystem for accepting connections using resolved credentials. The data source is created once and serves all subsequent connection requests for the process lifetime.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Create DB transactions" id="id-fb7b9763fa38483789172c4aab7d4a1b">
            <documentation>Begin a new unit of work against the database. All operations within the unit succeed or fail together. The caller chooses final disposition (commit or rollback) or delegates to an auto-complete runner that commits on success and rolls back on failure.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch connection string" id="id-bd15302203414213a6b226d682bd36d5">
            <documentation>Resolve database credentials from external configuration. Validates that credentials are not stored inline in the configuration file — they must be referenced indirectly. Fails with a structured error if the credentials cannot be resolved.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Roll back DB transactions" id="id-055e0d8c2fc14d82afa41343ba61c431">
            <documentation>Discard all changes performed within an open transaction. The transaction is consumed — it cannot be reused after rollback.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Spool reader results" id="id-ecf432c0c77f4e81b3281af0d8d8202c">
            <documentation>Given a database result set and a row-mapping function, produce a list of typed values — one per row. Each row is visited exactly once.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Provide explicit instruction for updating fields" id="id-910e9238028f4b7d9af3e26770aaa5cc">
            <documentation>Gives the caller explicit means to distinguish between &quot;don't change&quot; and &quot;set to null&quot;</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Mitigate SQL injection vulnerability" id="id-f6be381c5cbf4844997436a6f76a689f">
            <documentation>Prevent untrusted input from being executed as database commands.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Validate result count" id="id-10bb8d9944b2487a8052c1723340e8d4">
            <documentation>After a query executes, verify that the number of affected or returned rows matches an expected cardinality constraint (zero, exactly one, one-or-many, or unconstrained). A mismatch produces a structured error — the caller never receives a surprising number of results silently.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Assemble query string" id="id-95d7fca778e6493aa351a630866081d4">
            <documentation>Compose a SQL query from structured building blocks (CTEs, select clauses, from clauses, joins, predicates, grouping, ordering, limits). The output is a parameterised SQL string — never a string with interpolated values.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute types" id="id-e5e5d3b3a9f84ab39c440b7c537555f8">
            <documentation>Given raw database column values, construct a validated domain type. Each reconstitution is fallible — malformed or semantically invalid data produces a structured error, never a corrupt domain object.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Query execution" id="id-f0b69b1153454871a93b049706c0fe42">
            <documentation>Send a parameterised command to the database and process the response. Covers reads (result sets), scalar returns (single values), and writes (affected row counts). The command participates in an existing unit of work if one is active. Database-level failures are captured as structured errors.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Cache known values" id="id-9a9d5252f1894ba7b5388edc4fc0cb3f">
            <documentation>Provide fast bidirectional translation between typed identifiers (used in the model layer) and human-readable codes or names (used at the boundary). Known values are loaded eagerly; unknown values are resolved on demand. The set of known values is assumed stable for the process lifetime.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Assemble filter predicates and parameters" id="id-f8ee389ba4b4497d9d9c6f53035a1f75">
            <documentation>Turn an operator's filter (IDs, names, amounts, dates, partial strings) into a SQL predicate and its parameters.</documentation>
          </element>
        </folder>
        <folder name="Lifecycle functions" id="id-d92d328dfaf7400695116fc225a5bafc">
          <element xsi:type="archimate:ApplicationFunction" name="Lifecycle functions" id="id-ba605f5711c4469480ea1fa67b74a612">
            <documentation>Behaviours that define, assess, or transition the temporal status of a domain entity. Members of this clade share a defining characteristic: they answer &quot;where is this entity in its lifespan?&quot; — whether it is operative, what stage it is in, or whether it has crossed a threshold. They provide the lifecycle infrastructure that domain entities realise with domain-specific rules.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define a bounded operative period" id="id-5c19efccfa784834a1c708cf97c64ed8">
            <documentation>Describe the shape of a bounded time range — a begin date, an optional end date, and a rule governing whether the period is considered available before its begin date.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate a bounded operative period" id="id-57bb6001a06840e89389cc6711716da7">
            <documentation>Given a begin date, an optional end date, and a begin-availability rule, produce a valid operative period. Fails if the end date precedes the begin date.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Determine whether an entity is operative at a point in time" id="id-efcfc82da68c4caabe4765e30a111ae1">
            <documentation>Given a reference date and a bounded operative period, determine whether the entity is active at that date. Active means the begin date is in the past and the end date (if any) is in the future. Strict — no grace period.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Determine whether an entity is available at a point in time" id="id-fd96f7c31ec047e8a891eeef071d901d">
            <documentation>Given a reference date and a bounded operative period, determine whether the entity is available at that date. Availability may differ from activity — an entity may be considered available before its operative period begins if its availability rule permits it.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Transition an entity between lifecycle states" id="id-9a2a203f7bba4df2a1b689206dbdc1d5">
            <documentation>Move an entity from one lifecycle state to another. The transition is guarded — attempting a no-op transition (e.g. closing an already-closed entity) produces a structured error. The set of valid states and transitions is defined by the domain entity, not by this function.</documentation>
          </element>
        </folder>
        <element xsi:type="archimate:ApplicationFunction" name="Utility functions" id="id-95843fd1284b4eff9b88dd3e7e4a8220">
          <documentation>Behaviours that serve any domain without belonging to any domain. Members of this clade share a defining characteristic: they provide general-purpose capabilities (time, errors, files, configuration, data access) that the system needs regardless of what business problem it solves.</documentation>
        </element>
      </folder>
      <folder name="Financial services functions" id="id-c7eb2bd03f374c34aca4e2924cce732a">
        <folder name="Currency functions" id="id-b2914bb984fc4e9dbd385b71d30f4884">
          <element xsi:type="archimate:ApplicationFunction" name="Define what &quot;money&quot; means in a ledger" id="id-2b72f6f2d69c431aa4acd26b3530a225">
            <documentation>Establish the canonical representation of monetary amounts — the precision, bounds, and constraints that distinguish a valid monetary value from a raw number. This definition is the contract that all monetary operations honour.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Split money N ways" id="id-7714b2f0f8aa41af88e39d9dd0cfd18b">
            <documentation>Given a monetary amount and a count, divide the amount into that many shares such that the shares sum exactly to the original. Remainder pennies are distributed across shares — no value is lost or created.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Add two monies" id="id-50c2ccefcf00444bb010776d2ca7dbc7">
            <documentation>Given two monetary amounts, produce their sum as a valid monetary amount.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Subtract one money from another" id="id-7d0380c08ad844b09724bb5c7fbe2781">
            <documentation>Given two monetary amounts, produce their difference as a valid monetary amount.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Confirm money type validity" id="id-816e2957e2f24c54891f79f1de183f0b">
            <documentation>Given a candidate numeric value, determine whether it satisfies the precision and bounds constraints that define a valid monetary amount. Rejects values with incorrect decimal precision or values outside the permitted range.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Currency functions" id="id-68d71222361949579b69ca91eae22be4"/>
          <element xsi:type="archimate:ApplicationFunction" name="Sum a list of monies" id="id-8de055c3d4db4db084b1d0f139700875">
            <documentation>Given a list of money values, produce their total as a single money value.</documentation>
          </element>
        </folder>
        <folder name="Ledger functions" id="id-c5774940938a4e94b40654b5640c9734">
          <folder name="Account functions" id="id-689a74ee57ea46b4abfe1853fc8956b3">
            <element xsi:type="archimate:ApplicationFunction" name="Account functions" id="id-a1690119289043169e3e8258590a51f1">
              <documentation>Behaviours that define, create, retrieve, and modify accounts within the ledger. Members of this clade share a defining characteristic: they operate on the account entity — the named node in the chart of accounts that transactions post to.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch account by ID" id="id-5dc22e9ffb0f44e8a808797f66768be3">
              <documentation>Given a typed account identifier, retrieve the corresponding account record from persistent storage.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Define what &quot;account&quot; means in a ledger" id="id-c01a8b6c81ef4b2c8fa81446b2252cee">
              <documentation>Establish the canonical representation of an account — its identity, classification, hierarchical position, and the constraints that distinguish a valid account from arbitrary data.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Confirm account type validity" id="id-1a964c44e1a54cdfbd6cbf8902f1c2ad">
              <documentation>Given a candidate account classification, determine whether it is a recognised account type. Rejects values outside the system's defined vocabulary of account types.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Instantiate an account record" id="id-112c9d85688f452e86700e88b5c18ed3">
              <documentation>Given the attributes of an account, produce a new account record. The record is created in memory — it is not yet persisted.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Reconstitute account records" id="id-ab68a7cf900248f2b206d2de5423c879">
              <documentation>Given raw stored values representing an account, produce a validated account record. Fails if the stored values do not represent a valid account.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Persist account records" id="id-ffb2193dc58443bea74d35e430bc459e">
              <documentation>Given a valid account record, write it to persistent storage. The account becomes retrievable by its identifier after persistence.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch account by parent ID" id="id-de70971658894cee98718025e3d21510">
              <documentation>Given a typed account identifier, retrieve all accounts that are direct children of that account in the chart of accounts hierarchy.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch account by type" id="id-925014b72b3444faa7e4a4dbf0e4175a">
              <documentation>Given an account type classification, retrieve all accounts of that type.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch all accounts" id="id-0ffdc3c04c6147ef8b894ab04ad69a54">
              <documentation>Retrieve every account in the ledger.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Update account name" id="id-f17d4ecfe32644e89bcfa51e92da22cd">
              <documentation>Given a typed account identifier and a new name, change the account's display name in persistent storage.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Update account external reference ID" id="id-7cbec99538d5406b8783c90c8f008374">
              <documentation>Given a typed account identifier and a new external reference, update the account's linkage to an external system in persistent storage.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Create and persist a new account" id="id-d42a0c0e07ee47fdb2d5ca693afde31a">
              <documentation>Validate a new account against the chart of accounts and write it.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Deactivate an account" id="id-23411b28df6c4d4da222e2dcb2916252">
              <documentation>Set the end of an account's active period, refusing when it would strand activity.</documentation>
            </element>
          </folder>
          <folder name="Fiscal period functions" id="id-cc987ebf69504969997be12e5c69d612">
            <element xsi:type="archimate:ApplicationFunction" name="Define what &quot;fiscal period&quot; means in a ledger" id="id-bdaa658644a54f9ebb7dd1827e6f7c06">
              <documentation>Establish the canonical representation of a fiscal period — the bounded time span used to partition the ledger's activity for reporting and reconciliation purposes.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fiscal period functions" id="id-0cc01f9d2691450393e6cca41ce48288">
              <documentation>Behaviours that define, validate, and retrieve fiscal periods within the ledger. Members of this clade share a defining characteristic: they operate on the fiscal period entity — the time-bounded container that groups ledger activity for reporting.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Confirm fiscal period type validity" id="id-d9072b88b506473a9b425d57bf1a7372">
              <documentation>Given a candidate fiscal period classification, determine whether it is a recognised fiscal period type. Rejects values outside the system's defined vocabulary of fiscal period types.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Instantiate a fiscal period record" id="id-c7a95f88e94047bc8bd2cb4dfab6946e">
              <documentation>Given the attributes of a fiscal period, produce a new fiscal period record in memory. The record is not yet persisted.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Persist fiscal period records" id="id-aa5450243a5e452c8ed1a230c4688cb0">
              <documentation>Given a valid fiscal period record, write it to persistent storage. The fiscal period becomes retrievable by its identifier after persistence.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch fiscal period by ID" id="id-e0a6c84f326d4dafb9adca5ab3213bc8">
              <documentation>Given a typed fiscal period identifier, retrieve the corresponding fiscal period record from persistent storage.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch fiscal period ID by key" id="id-da2d5ce35601409980716a59c86f8b97">
              <documentation>Given a fiscal period key, resolve the corresponding typed fiscal period identifier.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch all fiscal periods" id="id-87e63121be064d27b7f82b97d5325e6a">
              <documentation>Retrieve all fiscal periods, optionally filtered to only those that are open.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Close a fiscal period" id="id-e4a3d669b7474aebad64440ffe305fc7">
              <documentation>Transition a fiscal period from open to closed, preventing further entries from posting to it. Fails if the fiscal period is already closed.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Reopen a fiscal period" id="id-dacdd861fd2b4ff0801e437957d3c5fa">
              <documentation>Transition a fiscal period from closed to open, allowing entries to post to it again. Fails if the fiscal period is already open.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Create and persist a new fiscal period" id="id-d5040e35df664ae5a430199b1eae9d6b">
              <documentation>Validate a new fiscal period's key and dates and write it.</documentation>
            </element>
          </folder>
          <folder name="Journal entry functions" id="id-f3be016471754f93abd1fb7f5316332e">
            <element xsi:type="archimate:ApplicationFunction" name="Journal entry functions" id="id-6cd96ace557e4b49910c011e7bcef02c">
              <documentation>Behaviours that define, create, retrieve, and annotate journal entries within the ledger. Members of this clade share a defining characteristic: they operate on the journal entry entity — the double-entry record that posts debits and credits to accounts.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Define what &quot;journal entry&quot; means in a ledger" id="id-abdaf4f0a48644138efc28334cd5df91">
              <documentation>Establish the canonical representation of a journal entry — its identity, composite structure (header, lines, comments, external references), the constraints that govern valid entries, and the classification of line types.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Confirm journal entry field validity" id="id-9799fb1e01884e30807f88b6f3dd463b">
              <documentation>Given candidate values for journal entry fields (descriptions, sources, memos, comment text, reference identifiers), determine whether each satisfies the constraints that define a valid value — non-empty, within length bounds, properly normalised.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Instantiate a journal entry header" id="id-3479d290c1bf4f789a7eb8a09797660b">
              <documentation>Given the attributes of a journal entry header (description, source, entry date, void status), produce a new header record in memory. The record is not yet persisted.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Persist journal entry headers" id="id-8239d7d1fa6c4cbb955c754517c5d427">
              <documentation>Given a valid journal entry header, write it to persistent storage. The header becomes retrievable by its identifier after persistence.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry header by ID" id="id-f20c38ece3d94cd9858d8bd08fbce02b">
              <documentation>Given a typed journal entry header identifier, retrieve the corresponding header record from persistent storage.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry headers by fiscal period" id="id-afb43144f8694657b06ed66ba3083bf8">
              <documentation>Given a typed fiscal period identifier, retrieve all journal entry headers posted to that period, ordered by entry date.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Instantiate a journal entry line" id="id-f73677f708534a39a8dcdb60c351c26e">
              <documentation>Given the attributes of a journal entry line (header reference, account, amount, debit/credit classification, optional memo), produce a new line record in memory. The record is not yet persisted.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Persist journal entry lines" id="id-3fa25e2dd70245c999d99ae67d475d04">
              <documentation>Given a valid journal entry line, write it to persistent storage. The line becomes retrievable by its identifier after persistence.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry line by ID" id="id-296f5119eaf847dfac4329f1cc24bcb2">
              <documentation>Given a typed journal entry line identifier, retrieve the corresponding line record from persistent storage.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry lines by header" id="id-6b4ac71167e444b8b632249c45fee5c4">
              <documentation>Given a typed journal entry header identifier, retrieve all lines belonging to that journal entry, ordered by creation time.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry lines by header batch" id="id-5b8aae91f41c4c8c9315996c15a856a1">
              <documentation>Given a list of typed journal entry header identifiers, retrieve all lines belonging to any of those journal entries in one operation. Fails if the list is empty.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry lines by account" id="id-085ee5b6885c4692b4872ca9349846d6">
              <documentation>Given a typed account identifier, retrieve all journal entry lines posted to that account. Optionally excludes lines belonging to voided journal entries.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Instantiate a journal entry external reference" id="id-ad5c57fdff0b483c8987aab3c12b462f">
              <documentation>Given the attributes of an external reference (header reference, financial institution name, reference text), produce a new external reference record in memory. The record is not yet persisted.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Persist journal entry external references" id="id-b6893811cd7f4151a3351b8785689a83">
              <documentation>Given a valid external reference record, write it to persistent storage. The reference becomes retrievable by its identifier after persistence.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry external reference by ID" id="id-d790069c51724473afcf34c49f0ad235">
              <documentation>Given a typed journal entry external reference identifier, retrieve the corresponding record from persistent storage.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry external references by header" id="id-7044bad77e114d998efd80f1d7b31518">
              <documentation>Given a typed journal entry header identifier, retrieve all external references associated with that journal entry.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry external references by header batch" id="id-a7f9a642c0294e1584eb9efafa30d8f7">
              <documentation>Given a list of typed journal entry header identifiers, retrieve all external references associated with any of those journal entries in one operation.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Instantiate a journal entry comment" id="id-1ed69683c1e14376b14094e7c79bdf02">
              <documentation>Given a primary journal entry reference, an optional secondary journal entry reference, and comment text, produce a new comment record in memory. The record is not yet persisted.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Persist journal entry comments" id="id-d248592053344969b857bffc62f95811">
              <documentation>Given a valid journal entry comment, write it to persistent storage. The comment becomes retrievable by its identifier after persistence.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry comment by ID" id="id-185bc20f69d44d05935c894a604328ea">
              <documentation>Given a typed journal entry comment identifier, retrieve the corresponding record from persistent storage.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry comments by journal entry" id="id-f4d0be97d06b4e3aa425faf08f09255c">
              <documentation>Given a typed journal entry header identifier, retrieve all comments that reference that journal entry — whether as primary or secondary reference.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch journal entry comments by header batch" id="id-0a51f5fd0adc4470a06201da3aea0c99">
              <documentation>Given a list of typed journal entry header identifiers, retrieve all comments that reference any of those journal entries as their primary reference. Secondary references to headers outside the batch are not searched.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Reconstitute journal entry records" id="id-4460bc517b284ac9ba21f310ae5936f5"/>
            <element xsi:type="archimate:ApplicationFunction" name="Sum journal entry lines by type" id="id-28f4a22af7dd4810b23341e0832f339d">
              <documentation>Given a set of journal entry lines, total the debits and the credits separately.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Create and persist a journal entry header" id="id-ff106a74327d4fe38b4d78158386a0ab">
              <documentation>Validate and write a new journal entry header.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Create and persist a journal entry line" id="id-b65b5e37aad3448da6b9b6635f876688">
              <documentation>Validate and write a new journal entry line.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Create and persist a journal entry external reference" id="id-bf1876e57aad4a828bc6d46b6cb45eb9">
              <documentation>Validate and write a new external reference on a journal entry.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Update a journal entry external reference" id="id-b22eb72daf5c47a8a1f5bacaea68604d">
              <documentation>Change an external reference's institution or text.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Create and persist a journal entry comment" id="id-e135dc46abda4a999c7219fc3dca4266">
              <documentation>Validate and write a new comment on a journal entry.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Update a journal entry comment" id="id-00170b73ab6f40e4ac8f5af849d88e49">
              <documentation>Change a journal entry comment's text.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Post a complete journal entry" id="id-08d29199994c4e7c8b19f36d42915412">
              <documentation>Write a balanced journal entry with its lines, external references and comments as one unit.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Confirm journal entry lines balance" id="id-cce7439274b540b492368a93c42f045d">
              <documentation>Reject a set of lines whose debits and credits do not net to zero.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch complete journal entries by filter" id="id-393421cea2964415a071af5af4d943ac">
              <documentation>Read whole journal entries (header, lines, references, comments) matching a filter.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch complete journal entry by ID" id="id-12683a5600584ae29b324c4159ec6cb2">
              <documentation>Read one whole journal entry.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch complete journal entries by fiscal period" id="id-b552855027e64731bc36856308876380">
              <documentation>Read the whole journal entries of a fiscal period.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch complete journal entries by date range" id="id-d0c4923bfd3643e8a56e6cde92b9a609">
              <documentation>Read the whole journal entries dated within a range.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch complete journal entries by external reference" id="id-73c3530e3602492083d3999e3d1c8c7c">
              <documentation>Read the whole journal entries carrying an external reference.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Void a journal entry" id="id-5acc23b5f65e478b811d79c1707df4b3">
              <documentation>Mark a journal entry void and post the entry that reverses it.</documentation>
            </element>
          </folder>
          <folder name="Ledger reporting functions" id="id-50ddd1c4eb30466896466d00909656aa">
            <element xsi:type="archimate:ApplicationFunction" name="Ledger reporting functions" id="id-1432d98bd0e54feebfc8249427edfc34">
              <documentation>Behaviours that read the ledger to answer balance and activity questions without changing it.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch account activity by filter" id="id-30bd49af8f38474685960151332396d0">
              <documentation>Read accounts together with the journal entry lines that touch them.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Fetch account balances as of a date" id="id-0af708a62a7846549cee9866bb7d80cf">
              <documentation>Compute each account's debits, credits and net balance as of a date.</documentation>
            </element>
            <element xsi:type="archimate:ApplicationFunction" name="Compute a trial balance with parent roll-up" id="id-30d160060dda4137a8bf206acc8dac4e">
              <documentation>Produce every account's debits, credits and net, with children rolled up into their parents.</documentation>
            </element>
          </folder>
          <element xsi:type="archimate:ApplicationFunction" name="Ledger functions" id="id-02a684e5afd946a8949031f15694a733">
            <documentation>Behaviours that define and maintain the structure and content of the general ledger — accounts, fiscal periods, journal entries, and the rules that govern them. Members of this clade share a defining characteristic: they operate on the permanent record of financial activity.</documentation>
          </element>
        </folder>
        <folder name="Data ingestion functions" id="id-1b3a9b6dd07e4a13bd1ac84a2d8fe065">
          <element xsi:type="archimate:ApplicationFunction" name="Data ingestion functions" id="id-36ac97d70705433a9598b367a0a37588">
            <documentation>Behaviours that move external financial data into the system's staging area, classify it, and prepare it for posting to the ledger. Members of this clade share a defining characteristic: they operate on data that has entered the system from an external source but has not yet become a permanent ledger record.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define what &quot;staged entry&quot; means in data ingestion" id="id-343a12b25bec4a47ac71464fc0d62918">
            <documentation>Establish the canonical representation of a staged entry — its identity types, the lifecycle statuses it moves through from ingestion to posting, the classification of actors that cause status changes, and the constraints on source file identification.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Confirm staged entry field validity" id="id-4f31ca20439a4cfdbdece9addba6b611">
            <documentation>Given candidate values for staged entry fields (source file names, lifecycle status values, change mechanism values), determine whether each satisfies its constraints.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate a stage entry status transition" id="id-47565d5b6a954485a1b48d069374f109">
            <documentation>Given a staged entry reference, a from-status (absent for the initial ingestion), a to-status, a timestamp, and the actor that caused the change, produce a new transition record in memory. The record is not yet persisted.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch stage entry transitions by header" id="id-a2d13e535d674ba8beefe286cca21c68">
            <documentation>Given a typed staged entry header identifier, retrieve all status transitions for that entry.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch stage entry transitions by header batch" id="id-4e1281a121f941fea89a9dae972193c9">
            <documentation>Given a list of typed staged entry header identifiers, retrieve all status transitions for those entries in one operation. Fails if the list is empty.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Validate stage entry status transition" id="id-17622c50eab247089a327e681834d5e0">
            <documentation>Given a proposed status transition, confirm that it is legal per the stage entry lifecycle state machine. Rejects transitions that violate the defined state graph.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Resolve stage entry status" id="id-3d9d94b23d2d49c1b1a2f27278d31b7d">
            <documentation>Determine the current or historical status of a staged entry from its transition history.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute stage entry transition records" id="id-7e4b1a7a4f5746ecb8921cb51442b754">
            <documentation>Given raw stored values representing a status transition, produce a validated transition record. Fails if the stored values do not represent a valid transition.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define the raw ingestion data shape" id="id-2c48325fc8ce4d95b8ffacf50e6d5646">
            <documentation>Describe the structure of financial data as it arrives from external sources — the fields, types, and grouping identity that raw import rows carry before they become staged entries. Uses the ledger's vocabulary because staged data will become ledger records.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate an ingestion source" id="id-e21d250d4f994743933c918dd0ad9b86">
            <documentation>Given the attributes of a data source (name), produce a new ingestion source record in memory. The record is not yet persisted.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist ingestion sources" id="id-7bb253a44a5247bca6b0f85beb32073c">
            <documentation>Given a valid ingestion source record, write it to persistent storage.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch ingestion source by name" id="id-c153e620ea214cc68d4be2ff5f8834b5">
            <documentation>Given a financial institution name, retrieve the corresponding ingestion source record. Fails if no source with that name exists.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute ingestion source records" id="id-e9c5eb35e3864dc189ca3b55c95e33c6">
            <documentation>Given raw stored values representing an ingestion source, produce a validated source record.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate a stage entry header" id="id-205219f03e8c406caec8ef744d71c2a7">
            <documentation>Given the attributes of a staged entry header (source file, entry date, description, FI reference, ingestion source), produce a new header record in memory. The record is not yet persisted.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist stage entry headers" id="id-98d5db83653e4763bf15b178ebe99256">
            <documentation>Given a valid stage entry header, an initial lifecycle status, and the actor causing the ingestion, write the header to persistent storage and record the initial status transition. This is a compound operation — header and first transition are persisted together.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch stage entry header by ID" id="id-57f02bf2a88e4c8b84228d38e778a7ce">
            <documentation>Given a typed stage entry header identifier, retrieve the corresponding header record from persistent storage.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch stage entry headers by ID batch" id="id-9b2cf4d323574cfbb5b92cdaccd9528b">
            <documentation>Given a list of typed stage entry header identifiers, retrieve all matching headers in one operation. Fails if the list is empty.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch stage entry headers by status" id="id-b9b73b72c9a449ea8ea506bd0eacd981">
            <documentation>Given a lifecycle status, retrieve all stage entry headers currently in that status.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch stage entry headers by source file" id="id-695a9d44b4b2410c9e3d33ca2850d989">
            <documentation>Given a source file name, retrieve all stage entry headers ingested from that file, optionally filtered to specific lifecycle statuses.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Detect duplicate stage entries" id="id-e47be99b72cb4cb0a11f7ce3efc0676e">
            <documentation>Identify staged entries that match existing ledger entries or earlier staged entries by financial institution and reference identifier. Ensures the same actual transaction is not ingested more than once.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update stage entry header fields" id="id-2b2490811f9445fe8949cbe79242143d">
            <documentation>Given a typed stage entry header identifier and a set of field-level update instructions, apply only the changed fields. Optionally transitions the header's lifecycle status as part of the same operation.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Transition stage entry status" id="id-30161dd4430544bba6fb0fcd8e5b6b0b">
            <documentation>Given a stage entry header, a new lifecycle status, and the actor causing the change, validate the transition and record it. Silently no-ops if the status has not changed.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute stage entry header records" id="id-93224f999aa446db9290429d2970d1fa">
            <documentation>Given raw stored values representing a stage entry header, produce a validated header record including its embedded ingestion source and derived current status.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate a stage entry line" id="id-deaeba2303f044f6b3aa46b7affe67d2">
            <documentation>Given the attributes of a stage entry line (header reference, amount, debit/credit type, optional account, optional memo), produce a new line record in memory. The record is not yet persisted.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist stage entry lines" id="id-2df84d7ee8d1471bac6a4714864345dc">
            <documentation>Given a valid stage entry line, validate that any referenced account exists, then write the line to persistent storage.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch stage entry line by ID" id="id-e2acfa142486403bb35d16e4c5282d38">
            <documentation>Given a typed stage entry line identifier, retrieve the corresponding line record from persistent storage.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch stage entry lines by ID batch" id="id-d82b5338c6bf42a18bf7695baabae38d">
            <documentation>Given a list of typed stage entry line identifiers, retrieve all matching lines in one operation. Fails if the list is empty.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch stage entry lines by header" id="id-9921a1600a6f4b0e80baa715d4d213e1">
            <documentation>Given a typed stage entry header identifier, retrieve all lines belonging to that staged entry.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch stage entry lines by header batch" id="id-ad5105b1cfeb4ac4bad87ed9ee30e081">
            <documentation>Given a list of typed stage entry header identifiers, retrieve all lines belonging to any of those staged entries in one operation. Fails if the list is empty.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update stage entry line fields" id="id-8c6be854c2534bf39e62b7bfbde923b0">
            <documentation>Given a typed stage entry line identifier and a set of field-level update instructions, apply only the changed fields. Validates any new account reference before applying.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Validate stage entry line account reference" id="id-e21b22f76882431a9c6acc0641a9ce0d">
            <documentation>Given an optional account identifier on a stage entry line, confirm that the referenced account exists in the ledger. Prevents staging data with invalid account references.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Link stage entry line to ledger" id="id-c090b163159f4a998ac612d636332ab1">
            <documentation>Given a typed stage entry line identifier and a typed journal entry line identifier, record the back-linkage from the staged line to the posted ledger line. This is the moment the staged data becomes traceable to its permanent ledger record.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute stage entry line records" id="id-eb291f2fdc7541e5a906bc3d55275988">
            <documentation>Given raw stored values representing a stage entry line, produce a validated line record.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Ingest raw rows to stage" id="id-3fb4597dd00b4c4faf86e0a778a5af2b">
            <documentation>Validate a raw file's rows and write them as staged entries, all or nothing.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Create an ingestion source" id="id-3dab923da92c4451bad1a6f4d0b5d7c4">
            <documentation>Write a new ingestion source.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Deduplicate staged entries" id="id-a7e4ae433ea2408bbb5baf5efb4536e9">
            <documentation>Mark every staged entry that duplicates one already in the database.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Classify staged entry accounts" id="id-965866b8c7bb4cc0a3f56aefff83e150">
            <documentation>Run account classification over unresolved staged entries, write winning accounts, and re-derive each entry's status.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update a staged entry" id="id-6f38ae043075454fbb87bdf9edecc79b">
            <documentation>Apply operator changes to a staged entry and its lines.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Post staged entries to the ledger" id="id-8a8dc8f6fbc044698855d7c4365e8c6f">
            <documentation>Write every postable staged entry to the ledger and link each back to the journal entry it became.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch complete staged entries by filter" id="id-afe4dad4097b46738298eef78168132f">
            <documentation>Read whole staged entries (header, lines, transitions) matching a filter.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch complete staged entries by status" id="id-57bc1f87ae9f4624ae7b9af73f1c9223">
            <documentation>Read the whole staged entries in a set of statuses.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch complete staged entries by source file" id="id-5288849209e341349a34f00c160093cf">
            <documentation>Read the whole staged entries ingested from one file.</documentation>
          </element>
        </folder>
        <folder name="Cash flow functions" id="id-8ac6f77351f94289941bd53c4587437c">
          <element xsi:type="archimate:ApplicationFunction" name="Cash flow functions" id="id-8caa490eafca4592894d0ecb5896e2f5">
            <documentation>Behaviours that model recurring obligations — agreements, their instances, invoices and payments — and project the cash they will move.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define what &quot;agreement&quot;, &quot;instance&quot;, &quot;invoice&quot; and &quot;payment&quot; mean in cash flow" id="id-4a593584c92e427984d891d7b1667116">
            <documentation>The identifiers, names, states, directions and bounded values from which every cash flow entity is built.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Confirm cash flow field validity" id="id-ff37f77946224b85aa56cda0413c7109">
            <documentation>Given a raw value for a cash flow field, produce the typed value or a structured error when it is out of range or malformed.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Validate invoice state against flow direction" id="id-4660a2c301584010b1186aca2eed47c7">
            <documentation>Reject an invoice state that cannot occur for the agreement's direction of cash flow.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate a master agreement" id="id-53b2695fc2354ad2994f2fa76291fc78">
            <documentation>Construct a master agreement from its fields.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist master agreements" id="id-9ce52d486e8043bcb84d3baaef5ae13e">
            <documentation>Write a new master agreement to the database.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch master agreement by ID" id="id-1e6aeff5e18545a485c1be669a5a1d8a">
            <documentation>Read one master agreement.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch master agreements by ID batch" id="id-154b69baf53d4e7babda9a8f03a4fe40">
            <documentation>Read several master agreements in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update master agreement fields" id="id-7a3463e4e0e9461ca293a0e4d3b40874">
            <documentation>Apply a set of field updates to an existing master agreement.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update master agreement cadence" id="id-319ba5c4e0de458582a17208abc64c4f">
            <documentation>Replace the cadence on which an agreement recurs.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute master agreement records" id="id-cd337c3e28404062a60255f88e520462">
            <documentation>Rebuild a typed master agreement from a database row.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate a payment agreement" id="id-12c043c43fb140509ed1b62784b4c49b">
            <documentation>Construct a payment agreement from its fields.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist payment agreements" id="id-eaf6d75f9e164a4282839723f82061c9">
            <documentation>Write a new payment agreement to the database.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment agreement by ID" id="id-5e75c6dbf4234f408bae2ba528e2ee9b">
            <documentation>Read one payment agreement.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment agreement by name" id="id-a77e27f9021149caa46442fd64d9e36b">
            <documentation>Read the payment agreement with a given name.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment agreements by master agreement batch" id="id-1dc00747206a4da48ed796e349262d5e">
            <documentation>Read the payment agreements of several master agreements in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment agreements by ID batch" id="id-115731b64a0943f3931a157564293aa3">
            <documentation>Read several payment agreements in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update payment agreement fields" id="id-0f8beed428ef492ba39679fdd1b6e03d">
            <documentation>Apply a set of field updates to an existing payment agreement.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Resolve accounts for a flow direction" id="id-370d25bbdcec4c17a43c0c3631fcd7aa">
            <documentation>Given a payment agreement and its direction, name the counter account and the cash account the money moves between.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute payment agreement records" id="id-ec732d7a6104422dac9403e63dde6513">
            <documentation>Rebuild a typed payment agreement from a database row.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate an instance" id="id-5f63b83e5d034864aaba03e77ab5c15b">
            <documentation>Construct one occurrence of an agreement's obligation.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist instances" id="id-a751b0251a8c42149a07d67855b2b923">
            <documentation>Write a new instance to the database.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch instance by ID" id="id-cbc4ad558c7e4c148d4914058bcc98a9">
            <documentation>Read one instance.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch instances by master agreement batch" id="id-50eedff928a746b6aa995874abbb4dba">
            <documentation>Read the instances of several master agreements in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch instances by fulfillment" id="id-ca1df238ec054b0baa3d08b7528b58cf">
            <documentation>Read the instances that are, or are not yet, fulfilled.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update instance fields" id="id-dbd69e61e1d745b38fa1c8a28894bf82">
            <documentation>Apply a set of field updates to an existing instance.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute instance records" id="id-1009a1f5a04b4da584a06fa61b8f8e44">
            <documentation>Rebuild a typed instance from a database row.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate an invoice" id="id-27dff60248cf4cd3bd57a9698cd219be">
            <documentation>Construct an invoice against an instance.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist invoices" id="id-9429f5980fd6419584a6efe36b1e6510">
            <documentation>Write a new invoice to the database.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch invoice by ID" id="id-d4ab2690569649c29724e06a2e2d67c6">
            <documentation>Read one invoice.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch invoices by ID batch" id="id-9dd7add49e884543a84d76a4cfadcbfc">
            <documentation>Read several invoices in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch invoices by instance batch" id="id-e49db552d2a7445b845aa3699391938b">
            <documentation>Read the invoices of several instances in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update invoice fields" id="id-43497d68404d4695be26684cc8279695">
            <documentation>Apply a set of field updates to an existing invoice.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Derive invoice life-cycle state" id="id-051aa254aea24f65ac9ec190863c5a56">
            <documentation>Work out an invoice's invoice, payment and posted states from its own fields and its payments.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute invoice records" id="id-0b1b27dd054a4f66934d4bf2dd0265c3">
            <documentation>Rebuild a typed invoice from a database row.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate a payment" id="id-671a0e18e2a748c786c0840571fb79f0">
            <documentation>Construct a payment against an invoice.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist payments" id="id-7bf65e43c13245cbbfdef403d4c57169">
            <documentation>Write a new payment to the database.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment by ID" id="id-93e62e3003dd4ac9bf9abce0abac998e">
            <documentation>Read one payment.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payments by invoice batch" id="id-e6c2d8eb4c0d4f848673e0b2baf29e44">
            <documentation>Read the payments of several invoices in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment by staged transaction pointer" id="id-6628e6a9c48d4306b0963ba2b0812a4c">
            <documentation>Read the payment that points at a given staged entry line.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payments by stage entry line batch" id="id-72346b1bcc624943aa5ade35dbe2ab08">
            <documentation>Read the payments pointing at several staged entry lines in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update payment fields" id="id-808406b5a65848498c6fb184ae8ccf78">
            <documentation>Apply a set of field updates to an existing payment.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Delete a payment" id="id-87057fe88b6242f7a3228b087dc4b3bf">
            <documentation>Hard-delete a payment that never should have been recorded.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Resolve a payment's transaction pointer" id="id-72734c3b35644d34b3fa5f5925fe93fa">
            <documentation>Say whether a payment points at a staged entry line or at the journal entry line it became.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute payment records" id="id-f01ccc04a69143e08fda80e4407316a2">
            <documentation>Rebuild a typed payment from a database row.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate a payment agreement link" id="id-06524713ec3e4d79a9b8c7cf2718e249">
            <documentation>Construct the linkage between a staged entry line and the payment agreement it satisfies.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist payment agreement links" id="id-e75d4f7406c54ec1828411b7f4a2b2ad">
            <documentation>Write a new payment agreement link to the database.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment agreement link by ID" id="id-0a0e1c7fa66440beb356bab8423ea869">
            <documentation>Read one payment agreement link.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment agreement links by payment agreement" id="id-385b3620d78c4208b312693bc1699ec0">
            <documentation>Read the links of one payment agreement.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment agreement links by payment agreement batch" id="id-b9c8b44d6841404d9ce699cf3002f602">
            <documentation>Read the links of several payment agreements in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment agreement link by stage entry line" id="id-dd4a9abdefc14be29256b30a556fb592">
            <documentation>Read the link for one staged entry line.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch payment agreement links by stage entry line batch" id="id-e2ef128615e54432aeb0f8e6f1ebf3cd">
            <documentation>Read the links for several staged entry lines in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update payment agreement link" id="id-4c94537b99e148bbb4f24b2c9eb369b7">
            <documentation>Repoint a link at a different payment agreement.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Delete a payment agreement link" id="id-795be1a27cb94217ace624bafc7201cd">
            <documentation>Hard-delete a link for a line that is not an obligation.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch cash flow composites by filter" id="id-025b946075b947bd960dae6c9b97f2be">
            <documentation>Read agreements or invoices, with their related entities, matching a filter.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Create an instance with its invoices and payments" id="id-30482fa95c63404ea48fb90bee5f62e7">
            <documentation>Write one instance of an obligation together with any invoices and payments already known for it.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update an instance composite" id="id-46c9184b134a4835865e71d48e7e0452">
            <documentation>Apply changes to an instance, its invoices and payments, and re-derive their states.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch instance composites by filter" id="id-e7534733477946beb9322c4ac85c222b">
            <documentation>Read whole instances (invoices and payments) matching a filter.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch instance composite by ID" id="id-1bd8cad4954743e38a803d4c09237ea1">
            <documentation>Read one whole instance.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch instance composite by invoice" id="id-d3608492306e4a13a1c8d15d33f3db8d">
            <documentation>Read the whole instance that holds an invoice.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch instance composites by fulfillment" id="id-39a5d9af1797461eb71be964a29e35b3">
            <documentation>Read the whole instances that are, or are not yet, fulfilled.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Confirm instance composite consistency" id="id-b154f72c191346fbafc796d002aaf836">
            <documentation>Reject an instance whose invoices and payments contradict each other.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Create an agreement with its payment agreements" id="id-686e05adf5824b35880239e664a0cc3b">
            <documentation>Write a master agreement and its payment agreements as one unit.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update an agreement" id="id-51b2bd469e8d46b5935d1c55f9cde08b">
            <documentation>Change any of a master agreement's fields.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch agreements by filter" id="id-c3be091ce8b94fcdbfe9276facb5d14e">
            <documentation>Read the agreements matching a filter.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch agreement tree by master agreement" id="id-8b07628daf7b41acb12ba3e1759d3ffe">
            <documentation>Read one master agreement with its payment agreements, instances, invoices and payments.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch all active agreements" id="id-345eab242a984ef99e38c9de5a2c0a05">
            <documentation>Read every agreement active on a reference date.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Create upcoming instances from cadences" id="id-59b89811621043e382b7f3681ecf416c">
            <documentation>Walk every active agreement's cadence and create the instances, and any fixed-amount invoices, within the horizon.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Classify staged lines to payment agreements" id="id-c131f4e2cef643268e743109912c1484">
            <documentation>Match staged lines to payment agreements, link each uncontested match, and create the payments that follow.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Create a payment agreement link" id="id-554044340939420fb80e04ea2450d499">
            <documentation>Link a staged entry line to the payment agreement it satisfies, where classification left the decision to the operator.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Delete a payment and its linkage" id="id-9762437af0e94a23ad53c8b54e561771">
            <documentation>Remove a payment and the payment agreement link that produced it, then re-derive the instance.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Project cash flow N days forward" id="id-91167aca25a847f99dfbd9dfe6dd7db1">
            <documentation>Compute each managed cash account's projected position from its posted balance and the unpaid invoices landing on it.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Transition payments to posted" id="id-42cf3ef4e7484f1dac0460bf1cbb76b1">
            <documentation>Repoint every payment whose staged line has since posted at its journal entry line, and re-derive invoice posted states.</documentation>
          </element>
        </folder>
        <folder name="Classification functions" id="id-0782d06bcb0c4e42a17757d56d1eadb5">
          <element xsi:type="archimate:ApplicationFunction" name="Classification functions" id="id-2cd1a6b0f4f14c808fb6e150aff6e050">
            <documentation>Behaviours that match staged lines against operator-authored rules to decide which account or payment agreement each line belongs to.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Define what &quot;classification rule&quot; means in classification" id="id-56f957264e6f455dacc2ea4210d37a88">
            <documentation>The identifiers, names, search patterns, connectors, claimants, candidates and outcomes from which classification is built.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Confirm classification field validity" id="id-43d44f07a1c945bbb2eb4b4cbe94bce4">
            <documentation>Given a raw value for a classification field, produce the typed value or a structured error.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Match a field against a search pattern" id="id-eb365fa47cf64579b6032769d41401eb">
            <documentation>Decide whether one property of a candidate (description, source, amount, line type) satisfies one search pattern.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Match a chain of field conditions" id="id-08dcd78f747a4fb3b62bf1dfe48e2933">
            <documentation>Decide whether a candidate satisfies every field match in a chain.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Combine field match chains with a connector" id="id-3232c9b3c97a45a5add41ad30407cf95">
            <documentation>Decide whether a candidate satisfies two chains joined by AND or OR.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate a classification rule" id="id-059fe93355ba4570ab4c4d92a736758a">
            <documentation>Construct a classification rule from its fields.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist classification rules" id="id-247d69749537400f810731d843bdac42">
            <documentation>Write a new classification rule to the database.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch classification rule by ID" id="id-9d3f63835bd246f5810d59c041c092e4">
            <documentation>Read one classification rule.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch classification rules by ID batch" id="id-9104540b69aa44f78646301ecad965b0">
            <documentation>Read several classification rules in one query.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch classification rule by name" id="id-dd83ee02093c4952aa79b375cc422a2e">
            <documentation>Read the classification rule with a given name.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Determine whether a rule constrains line type" id="id-741c9636489645aea617548be94e5720">
            <documentation>Say whether any of a rule's conditions restricts the debit/credit side of a line.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Evaluate a classification rule against a candidate" id="id-5de999bcb2cb4bc4bb26829f09528d4d">
            <documentation>Decide whether a candidate satisfies a rule's groups.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Reconstitute classification rule records" id="id-5dd8483ce37c4fd0b43ba6e4773c9842">
            <documentation>Rebuild a typed classification rule from a database row.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Instantiate a rule match" id="id-3528b15a8b264c1ab37d776a13c0a052">
            <documentation>Construct the record that a rule matched a staged line in a run.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Persist rule matches" id="id-eea4312b0b2246b39e2c8f32dbc25e4b">
            <documentation>Write a rule match to the database.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch rule match by ID" id="id-8aa02d00bdf646999dbe60bb2c137662">
            <documentation>Read one rule match.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch rule matches by run" id="id-3a97ebfc567c459f9846798f18ccb982">
            <documentation>Read every rule match recorded in a classification run.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch rule matches by run and claimant type" id="id-020a98a3366c438b96ae78ac14f7567b">
            <documentation>Read a run's rule matches for account rules or payment agreement rules only.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Classify a match candidate against active rules" id="id-528f97ed3b1148e8aca8dbdeae897d00">
            <documentation>Evaluate every active rule against one candidate and report no match, one match, a clear winner, or a tie.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Rank matching rules by priority" id="id-dd85fdb78c454d65bd2774a3f15ca42b">
            <documentation>Order a candidate's matching rules by priority to find a clear winner or a tie.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Create a classification rule" id="id-8c6d027f73ab4bad92f16dff78379563">
            <documentation>Validate and write a new classification rule with its groups.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Update a classification rule" id="id-e98c963738294705bdda54bbcda64af1">
            <documentation>Change any of a classification rule's fields.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch classification rules by filter" id="id-45601905041d4bf09a13c3c22a39f39f">
            <documentation>Read the classification rules matching a combination of filter inputs.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Fetch a classification run with its rules" id="id-d2cd34f5a1cb4191b1f3bc92314d344a">
            <documentation>Read a run's matches with each rule and each claimed entity resolved.</documentation>
          </element>
          <element xsi:type="archimate:ApplicationFunction" name="Classify candidates and record rule matches" id="id-bd57dd3256d947d99d0fc204d2a3507c">
            <documentation>Run the classifier over a set of candidates and record every matching rule under a new run.</documentation>
          </element>
        </folder>
        <element xsi:type="archimate:ApplicationFunction" name="Financial services functions" id="id-30a03788e5be455c88954787a3153e59">
          <documentation>Behaviours specific to the financial domain — monetary arithmetic, ledger management, and the rules that govern how money is represented, moved, and recorded. Members of this clade share a defining characteristic: they would not exist in a system that does not manage money.</documentation>
        </element>
      </folder>
    </folder>
    <folder name="Components (the &quot;how&quot;)" id="id-75426be5560948ee905968b8c7160c2e">
