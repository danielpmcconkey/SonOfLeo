  <folder name="Motivation" id="id-1c13acda58bd4e568f336e7ad12d50d7" type="motivation">
    <folder name="Principles" id="id-b042a9edb3b34032ab090f5e4241946f">
      <element xsi:type="archimate:Principle" name="Authority Hierarchy" id="id-9e5e7bd771a64009bd854f9ba5a9e60d">
        <documentation>Dan > Hobson > import script > classifier. A value written by a higher authority is never overridden by a lower one.</documentation>
        <property key="enforcement" value="absolute"/>
        <property key="source" value="standing-corrections"/>
        <property key="auditable" value="true"/>
        <property key="audit-strategy" value="Check that classifier never overwrites manual categorizations; import scripts never overwrite Hobson's corrections"/>
      </element>
      <element xsi:type="archimate:Principle" name="Infallible Create, Orchestrator Validates" id="id-8742bfb562224b2f81e02bf7cca6b4f3">
        <documentation>Create (construct) functions never fail. They accept all inputs. Validation lives in the orchestrator, not the entity. No exceptions in constructors.</documentation>
        <property key="enforcement" value="absolute"/>
        <property key="source" value="standing-corrections"/>
        <property key="auditable" value="true"/>
        <property key="audit-strategy" value="Scan construct functions for Result returns or exceptions; verify orchestrator functions perform validation before persistence"/>
      </element>
      <element xsi:type="archimate:Principle" name="Account IDs in Model, Codes at Boundary" id="id-9c04721a3d32403a82ebfb97bedaccbb">
        <documentation>The model layer uses typed account IDs. Human-readable account codes appear only at the InterfaceBridge boundary.</documentation>
        <property key="enforcement" value="absolute"/>
        <property key="source" value="standing-corrections"/>
        <property key="auditable" value="true"/>
        <property key="audit-strategy" value="Grep Model/ for account code strings; grep InterfaceBridge/ for account ID-to-code conversion"/>
      </element>
      <element xsi:type="archimate:Principle" name="Domain Owns Its Bookkeeping" id="id-c60e5ee28f8241959a6fe03186d4a70e">
        <documentation>A domain records its own bookkeeping on its own table. No domain writes to another domain's tables.</documentation>
        <property key="enforcement" value="absolute"/>
        <property key="source" value="standing-corrections"/>
        <property key="auditable" value="true"/>
        <property key="audit-strategy" value="Check that each Model/ domain folder's DAL functions only reference tables in that domain's schema"/>
      </element>
      <element xsi:type="archimate:Principle" name="No Backstop Creation" id="id-535200a97d604bbcb012f6c0b3f4f5b9">
        <documentation>If a required entity is missing, hard stop with rollback. Never silently create a placeholder to keep going.</documentation>
        <property key="enforcement" value="absolute"/>
        <property key="source" value="standing-corrections"/>
        <property key="auditable" value="true"/>
        <property key="audit-strategy" value="Scan orchestrator functions for create calls inside error/missing branches"/>
      </element>
      <element xsi:type="archimate:Principle" name="Dumb Orchestrator, Smart Agents, Fresh Contexts" id="id-6e1174fc8c2d46f4954c3253e1e98b52">
        <documentation>The pipeline engine is a deterministic state machine with zero LLM. All intelligence lives in agent blueprints. Every agent gets a fresh context.</documentation>
        <property key="enforcement" value="absolute"/>
        <property key="source" value="agentic-pipeline-plan"/>
        <property key="auditable" value="true"/>
        <property key="audit-strategy" value="Verify Pipeline/engine.py has no LLM calls; verify agent invocations pass --no-session-persistence"/>
      </element>
    </folder>
    <folder name="Constraints" id="id-04af52c597504a32b69436188c984910">
      <element xsi:type="archimate:Constraint" name="TransactionPointer Is Line-Level" id="id-6b50deb65e8043f390e64ad26bf456f3">
        <documentation>TransactionPointer carries line-level granularity on both the stage side and the ledger side. Never transaction-level only.</documentation>
        <property key="enforcement" value="absolute"/>
        <property key="source" value="standing-corrections"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Stage Entries Carry Back-Linkage" id="id-9dbfb773f600479485a33553b1e9f298">
        <documentation>Stage entries carry back-linkage to the ledger. The ledger does not point forward to staging.</documentation>
        <property key="enforcement" value="absolute"/>
        <property key="source" value="standing-corrections"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Public Repo — No PII" id="id-0587fa9a15364f3a973e0852ad476eee">
        <documentation>This is a public repo. No FI names, account numbers, or PII in any file.</documentation>
        <property key="enforcement" value="absolute"/>
        <property key="source" value="standing-corrections"/>
        <property key="auditable" value="true"/>
        <property key="audit-strategy" value="Grep for known FI name patterns, account number formats, email addresses"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Spec Language — Operator Concepts Only" id="id-72d2e3a3addf4f63837e60a864f97f42">
        <documentation>Specs use operator concepts, not implementation details. REQs describe what the system does, not how the code is structured.</documentation>
        <property key="enforcement" value="strong"/>
        <property key="source" value="standing-corrections"/>
      </element>
    </folder>
  </folder>
