            <folder name="AccountComponent" id="id-0b18ee4265f84c1ca86ae4add344db68">
              <element xsi:type="archimate:ApplicationComponent" name="AccountComponent" id="id-31eaa383f6c643e5b9045f39f06da5c1"/>
            </folder>
            <folder name="Account" id="id-fcacd256684c465b84aca7da7fc731d2"/>
            <folder name="FiscalPeriodComponent" id="id-db0b995af4b84209a2230987cd6c1160">
              <element xsi:type="archimate:ApplicationComponent" name="FiscalPeriodComponent" id="id-65fcb2dd45264dcd9220240b97b09548"/>
