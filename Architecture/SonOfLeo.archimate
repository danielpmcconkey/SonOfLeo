        <folder name="Business" id="id-63ad220e6de5490f86c499bf8ac769db">
          <folder name="Business.General" id="id-c2ecf9c5411e4327b7ff6b8a0b034b8c">
            <element xsi:type="archimate:ApplicationComponent" name="Business.General" id="id-5a130e86cd8742d09dcf8812c42b82d9">
              <property key="path" value="Src/Business.General/Business.General.fsproj"/>
            </element>
            <element xsi:type="archimate:ApplicationComponent" name="BizGeneralError" id="id-be94be4541b14c5580fcd92334fdba80">
              <property key="path" value="Src/Business.General/BizGeneralError.fs"/>
            </element>
            <element xsi:type="archimate:ApplicationComponent" name="ActivityPeriod" id="id-6f9e8ef33f654b0494d74734dc3b1feb">
              <property key="path" value="Src/Business.General/ActivityPeriod.fs"/>
            </element>
            <element xsi:type="archimate:ApplicationComponent" name="Cadence" id="id-c14ec84175694bd9ab5911eb7e76c79b">
              <property key="path" value="Src/Business.General/Cadence.fs"/>
            </element>
          </folder>
          <folder name="Business.FinancialServices" id="id-c147a831f4a04faaab3f3a2df33479de">
            <folder name="Business.FinancialServices.CashFlow" id="id-cc814b952a66400e8225685ad511a03d">
              <element xsi:type="archimate:ApplicationComponent" name="Business.FinancialServices.CashFlow" id="id-028369b6e73f4224b389b1cb9e325930">
                <property key="path" value="Src/Business.FinancialServices.CashFlow/Business.FinancialServices.CashFlow.fsproj"/>
              </element>
              <element xsi:type="archimate:ApplicationComponent" name="CashFlowError" id="id-1694657833c44d4db27afa22dafbb540">
